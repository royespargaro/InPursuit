+
+/* Narrow phones (iPhone SE / 360px Android) */
+@media (max-width: 380px) {
+  .content-wrap {
+    padding-left: max(12px, env(safe-area-inset-left));
+    padding-right: max(12px, env(safe-area-inset-right));
+  }
+
+  .panel {
+    padding: 14px;
+  }
+
+  .today-section-actions {
+    gap: 2px 10px;
+  }
+}
