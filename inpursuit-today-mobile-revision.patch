+}
+
+.today-section-actions {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+  gap: 4px 14px;
+}
+
+.today-section-count {
+  font: 11px 'JetBrains Mono', monospace;
+  color: var(--muted);
+}
+
+.today-list {
+  display: block;
+}
+
+.today-panel .priority-empty {
+  min-height: 0;
+  flex-direction: row;
+  justify-content: flex-start;
+  align-items: center;
+  gap: 10px;
+  padding: 12px 0;
+  text-align: left;
+  font-size: 13px;
+}
+
+.today-panel .priority-empty svg {
+  margin: 0;
+  flex: none;
+}
+
+.today-banner {
+  margin-top: 14px;
+  padding: 11px 14px;
+  border: 1px solid rgba(212, 255, 58, 0.4);
+  background: rgba(212, 255, 58, 0.08);
+  color: #e9ffa6;
+  font-size: 13px;
+}
+
+.today-panel-foot {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin-top: 22px;
+  padding-top: 12px;
+  border-top: 1px solid var(--line);
+}
+
+.today-overdue-wrap {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  border-bottom: 1px solid var(--line);
+}
+
+.today-overdue-wrap .task-row {
+  flex: 1;
+  min-width: 0;
+  border-bottom: 0;
+}
+
+.today-overdue-wrap .move-today-btn {
+  flex: none;
+}
+
+.task-row.is-skipped {
+  opacity: 0.55;
+}
+
+.habit-goal-meta {
+  display: block;
+  margin-top: 2px;
+  color: var(--muted);
+}
+
+/* Larger invisible tap area for the small round checkbox on every screen. */
+.check-control {
+  position: relative;
+}
+
+.check-control::after {
+  content: '';
+  position: absolute;
+  inset: -13px;
+}
+
+/* ---------- Phones ---------- */
+@media (max-width: 767px) {
+  html,
+  body {
+    min-height: 100dvh;
+  }
+
+  body {
+    overflow-x: clip;
+  }
+
+  .app-shell {
+    min-height: 100dvh;
+  }
+
+  .content-wrap {
