+  .fh-title { font-size: clamp(40px, 13cqw, 64px); overflow-wrap: anywhere; }
+}
+
+/* ---------- Today: single checklist ---------- */
+.today-panel .progress,
+.today-panel > .progress-track {
+  margin-top: 4px;
+}
+
+.today-section {
+  margin-top: 22px;
+}
+
+.today-section-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin-bottom: 4px;
