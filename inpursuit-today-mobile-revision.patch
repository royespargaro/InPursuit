+    overflow: visible;
+    text-overflow: clip;
+  }
+
+  .task-title-button small {
+    margin-top: 2px;
+    line-height: 1.35;
+    font-size: 11.5px;
+  }
+
+  .weekly-habit-actions,
+  .priority-reorder,
+  .habit-skip-btn,
+  .move-today-btn {
+    flex: none;
+  }
+
+  .weekly-habit-actions {
+    gap: 8px;
+  }
+
+  .habit-mini-btn {
+    min-width: 38px;
+    height: 34px;
+  }
+
+  .habit-skip-btn,
+  .move-today-btn,
+  .rough-day-btn {
+    min-height: 34px;
+    padding: 0 12px;
+  }
+
+  .text-action {
+    padding: 8px 2px;
+  }
+
+  .count-pill {
+    padding: 5px 10px;
+  }
+
+  .habit-summary > div {
+    padding: 14px 12px;
+  }
+
+  .panel-head {
+    gap: 10px;
+    flex-wrap: wrap;
+  }
+
+  .today-panel-foot {
+    padding-top: 10px;
+  }
+
+  /* Habit matrix scrolls inside its own container, never the page. */
+  .matrix-scroll {
+    max-width: 100%;
+    overflow-x: auto;
+    -webkit-overflow-scrolling: touch;
+  }
+
+  .habit-name-cell {
+    position: sticky;
+    left: 0;
+    z-index: 2;
+    background: #000;
+    padding-left: 4px;
+    padding-right: 10px;
+  }
+
+  /* iOS Safari zooms into inputs below 16px; keep them at 16px. */
+  input,
+  textarea,
+  select,
+  .search-input {
+    font-size: 16px;
+  }
+
+  /* Modals become bottom sheets. */
+  .modal-backdrop {
+    place-items: end center;
+    padding: 0;
+  }
+
+  .modal,
+  .plan-import-modal {
+    width: 100%;
+    max-width: 100%;
+    max-height: 92dvh;
+    padding: 18px 16px calc(18px + env(safe-area-inset-bottom));
+    border-left: 0;
+    border-right: 0;
+    border-bottom: 0;
