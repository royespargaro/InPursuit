# Server port (defaults to 3000)
PORT=3000

# Base64-encoded Firebase service account JSON for /api/* serverless functions
FIREBASE_SERVICE_ACCOUNT=

# Optional override for named Firestore database ID (defaults to firebase-applet-config.json)
FIREBASE_DATABASE_ID=

# Server-side Gemini API key for POST /api/import-plan (never expose in VITE_ vars)
GEMINI_API_KEY=

